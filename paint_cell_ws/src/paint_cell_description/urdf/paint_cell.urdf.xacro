<?xml version="1.0"?>
<!--
  Robotic car painting cell - KUKA KR 210 R3100-2 on a 2-axis floor track
  Frame: world = floor at cell centre. X = car length (car front = +X), Y = width, Z = up. Units: metres.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="paint_cell">

  <xacro:arg name="hardware" default="mock"/>      <!-- ros2_control hardware: mock | gazebo -->
  <xacro:arg name="controllers_file" default=""/>  <!-- ros2_controllers.yaml, needed for hardware:=gazebo -->
  <xacro:arg name="car_start" default="0.0"/>      <!-- conveyor_x at start: 0 = paint position, -10 = waiting outside the entry door -->

  <!-- ===== parameters ===== -->
  <xacro:property name="pkg"        value="paint_cell_description"/>
  <xacro:property name="skid_top"   value="0.5"/>    <!-- car bottom sits on skid rails -->
  <xacro:property name="track_y"    value="2.5"/>    <!-- track long sides at y = +-2.5 m (from reach study) -->
  <xacro:property name="track_x"    value="4.0"/>    <!-- track ends at x = +-4.0 m -->
  <xacro:property name="robot_z"    value="0.6"/>    <!-- robot mount = top of pedestal -->
  <xacro:property name="tcp_offset" value="0.6"/>    <!-- flange -> spray point: gun 0.35 + stand-off 0.25 -->

  <!-- box inertia; Gazebo drops links without mass, so the fixed parts get realistic values -->
  <xacro:macro name="box_inertial" params="m x y z cz">
    <inertial>
      <origin xyz="0 0 ${cz}"/><mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}" izz="${m*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="fixed_mesh_link" params="name mesh rgba *inertial">
    <link name="${name}">
      <visual>
        <geometry><mesh filename="package://${pkg}/meshes/visual/${mesh}.stl"/></geometry>
        <material name="${name}_mat"><color rgba="${rgba}"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://${pkg}/meshes/collision/${mesh}.stl"/></geometry>
      </collision>
      <xacro:insert_block name="inertial"/>
    </link>
  </xacro:macro>

  <link name="world"/>

  <!-- ===== fixed cell ===== -->
  <xacro:fixed_mesh_link name="loop_track" mesh="loop_track" rgba="0.45 0.45 0.45 1">
    <xacro:box_inertial m="600" x="8.3" y="5.3" z="0.1" cz="0.05"/>
  </xacro:fixed_mesh_link>
  <joint name="world_to_track" type="fixed">
    <parent link="world"/><child link="loop_track"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== skid conveyor: roller line along X through the entry door, the booth and the exit door =====
       Three sections with a 1.4 m transfer gap where the robot carriage crosses the car path (x = +-4.0).
       Roller tops at z = 0.40 m; the skid runners ride on them. -->
  <link name="conveyor">
    <visual>
      <geometry><mesh filename="package://${pkg}/meshes/visual/conveyor_frame.stl"/></geometry>
      <material name="conveyor_frame_mat"><color rgba="0.85 0.65 0.10 1"/></material>
    </visual>
    <visual>
      <geometry><mesh filename="package://${pkg}/meshes/visual/conveyor_rollers.stl"/></geometry>
      <material name="conveyor_roller_mat"><color rgba="0.72 0.74 0.78 1"/></material>
    </visual>
    <collision><origin xyz="-8.5 0 0.2"/><geometry><box size="7.6 1.0 0.4"/></geometry></collision>
    <collision><origin xyz="0 0 0.2"/><geometry><box size="6.6 1.0 0.4"/></geometry></collision>
    <collision><origin xyz="8.5 0 0.2"/><geometry><box size="7.6 1.0 0.4"/></geometry></collision>
    <xacro:box_inertial m="1500" x="24.6" y="1.0" z="0.4" cz="0.2"/>
  </link>
  <joint name="world_to_conveyor" type="fixed">
    <parent link="world"/><child link="conveyor"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- skid + car body travel on the conveyor: conveyor_x = 0 is the paint position (car centred in the booth),
       -10 = waiting outside the entry door, +10 = outside the exit door -->
  <xacro:fixed_mesh_link name="skid" mesh="skid" rgba="0.30 0.47 0.66 1">
    <xacro:box_inertial m="250" x="4.3" y="1.4" z="0.1" cz="0.45"/>
  </xacro:fixed_mesh_link>
  <joint name="conveyor_x" type="prismatic">
    <parent link="world"/><child link="skid"/><origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-10.0" upper="10.0" velocity="0.5" effort="5000"/>
  </joint>

  <!-- car body: the display mesh is split into the unpainted parts + one panel per paint zone
       (scripts/split_paint_zones.py), so each panel can take the paint colour on its own -->
  <xacro:macro name="car_visual" params="mesh">
    <visual>
      <geometry><mesh filename="package://${pkg}/meshes/visual/${mesh}.stl"/></geometry>
      <material name="car_primer"><color rgba="0.88 0.88 0.85 1"/></material>
    </visual>
  </xacro:macro>
  <link name="car_body">
    <!-- unnamed on purpose: Gazebo then names them car_body_visual_1..7 and the Gazebo-only primer colour applies -->
    <xacro:car_visual mesh="car_body"/>
    <xacro:car_visual mesh="paint_roof"/>
    <xacro:car_visual mesh="paint_hood"/>
    <xacro:car_visual mesh="paint_rear"/>
    <xacro:car_visual mesh="paint_left_side"/>
    <xacro:car_visual mesh="paint_right_side"/>
    <xacro:car_visual mesh="paint_front"/>
    <collision>
      <geometry><mesh filename="package://${pkg}/meshes/collision/car_body.stl"/></geometry>
    </collision>
    <xacro:box_inertial m="350" x="4.8" y="1.85" z="1.6" cz="0.8"/>   <!-- body-in-white -->
  </link>
  <joint name="skid_to_car" type="fixed">
    <parent link="skid"/><child link="car_body"/><origin xyz="0 0 ${skid_top}" rpy="0 0 0"/>
  </joint>

  <!-- window frames and pillars (display only) -->
  <link name="car_trim">
    <visual>
      <geometry><mesh filename="package://${pkg}/meshes/visual/car_trim.stl"/></geometry>
      <material name="car_trim_black"><color rgba="0.08 0.08 0.09 1"/></material>
    </visual>
    <xacro:box_inertial m="0.1" x="0.1" y="0.1" z="0.1" cz="1.2"/>
  </link>
  <joint name="car_to_trim" type="fixed">
    <parent link="car_body"/><child link="car_trim"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- tinted glass (display only; the car_body collision mesh still covers the windows) -->
  <link name="car_glass">
    <visual>
      <geometry><mesh filename="package://${pkg}/meshes/visual/car_glass.stl"/></geometry>
      <material name="car_glass_tint"><color rgba="0.05 0.08 0.12 0.45"/></material>
    </visual>
    <xacro:box_inertial m="0.1" x="0.1" y="0.1" z="0.1" cz="1.2"/>
  </link>
  <joint name="car_to_glass" type="fixed">
    <parent link="car_body"/><child link="car_glass"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== 2-axis track around the car =====
       track_x: 0 = middle of the long side, range -4.0 .. +4.0 m
       track_y: 0 = near long side (y = -2.5 m), 5.0 = far long side (y = +2.5 m)
       Two independent axes: the planner keeps the carriage on the rails (track_y = 0 or 5 on the long sides,
       track_x = +-4 on the ends). -->
  <link name="track_x_slider">
    <inertial><mass value="1.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="track_x" type="prismatic">
    <parent link="world"/><child link="track_x_slider"/>
    <origin xyz="0 ${-track_y} 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-track_x}" upper="${track_x}" velocity="1.0" effort="5000"/>
  </joint>

  <link name="carriage">
    <visual>
      <geometry><mesh filename="package://${pkg}/meshes/visual/carriage_pedestal.stl"/></geometry>
      <material name="carriage_mat"><color rgba="0.96 0.52 0.09 1"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://${pkg}/meshes/collision/carriage_pedestal.stl"/></geometry>
    </collision>
    <inertial><origin xyz="0 0 0.3"/><mass value="800"/><inertia ixx="100" iyy="100" izz="150" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="track_y" type="prismatic">
    <parent link="track_x_slider"/><child link="carriage"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="${2*track_y}" velocity="1.0" effort="5000"/>
  </joint>

  <!-- ===== KUKA KR 210 R3100-2 (official package: kuka_quantec_support) ===== -->
  <xacro:include filename="$(find kuka_quantec_support)/urdf/kr210_r3100_2_macro.xacro"/>
  <xacro:kuka_kr210_r3100_2_robot prefix="" package_name="kuka_quantec_support"/>
  <joint name="carriage_to_robot" type="fixed">
    <parent link="carriage"/><child link="base_link"/>
    <origin xyz="0 0 ${robot_z}" rpy="0 0 ${pi/2}"/>   <!-- robot faces +Y (towards the car) -->
  </joint>

  <!-- ===== spray gun + paint TCP ===== -->
  <link name="spray_gun">
    <visual>
      <geometry><mesh filename="package://${pkg}/meshes/visual/spray_gun.stl"/></geometry>
      <material name="gun_mat"><color rgba="0.15 0.15 0.18 1"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://${pkg}/meshes/collision/spray_gun.stl"/></geometry>
    </collision>
    <inertial><origin xyz="0 0 0.17"/><mass value="8"/><inertia ixx="0.1" iyy="0.1" izz="0.03" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="flange_to_gun" type="fixed">
    <parent link="tool0"/><child link="spray_gun"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- spray plume: cone of paint mist from the nozzle to the surface. Invisible here (alpha 0); in Gazebo the paint
       job shows it while spraying, in RViz it is drawn as a marker -->
  <link name="spray_plume">
    <visual>
      <geometry><mesh filename="package://${pkg}/meshes/visual/spray_plume.stl"/></geometry>
      <material name="plume_mat"><color rgba="0.35 0.55 1.0 0.0"/></material>
    </visual>
    <xacro:box_inertial m="0.01" x="0.1" y="0.1" z="0.1" cz="0.47"/>
  </link>
  <joint name="gun_to_plume" type="fixed">
    <parent link="spray_gun"/><child link="spray_plume"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="paint_tcp"/>   <!-- spray point: 250 mm in front of the nozzle, Z = spray direction -->
  <joint name="gun_to_tcp" type="fixed">
    <parent link="spray_gun"/><child link="paint_tcp"/><origin xyz="0 0 ${tcp_offset}" rpy="0 0 0"/>
  </joint>

  <!-- ===== ros2_control (track + arm) ===== -->
  <xacro:include filename="$(find paint_cell_description)/urdf/paint_cell.ros2_control.xacro"/>
  <xacro:paint_cell_ros2_control hardware="$(arg hardware)" controllers_file="$(arg controllers_file)"
                                 car_start="$(arg car_start)"/>

</robot>
