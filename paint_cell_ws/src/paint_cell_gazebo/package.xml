<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>paint_cell_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic simulation of the robotic car painting cell: paint booth world, gz_ros2_control and MoveIt.</description>
  <maintainer email="eyobshimelis00@gmail.com">Eyob Shimelis</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>paint_cell_description</exec_depend>
  <exec_depend>paint_cell_moveit_config</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
